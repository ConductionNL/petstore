{
  "openapi": "3.0.0",
  "info": {
    "title": "PetStore Register",
    "description": "Categories, pets, and orders for the PetStore app.",
    "version": "0.3.0"
  },
  "x-openregister": {
    "type": "application",
    "app": "petstore",
    "openregister": "^v0.2.10",
    "description": "PetStore — pets, orders, categories on the Conduction stack.",
    "rbac": true,
    "multitenancy": true
  },
  "paths": {},
  "components": {
    "registers": {
      "petstore": {
        "slug": "petstore",
        "title": "PetStore",
        "description": "Categories, pets, and orders for the PetStore app.",
        "version": "0.3.0",
        "schemas": ["category", "pet", "order"]
      }
    },
    "schemas": {
      "category": {
        "slug": "category",
        "icon": "Tag",
        "version": "0.2.0",
        "title": "Category",
        "description": "A category of pets (Dogs, Cats, Reptiles, Fish, ...).",
        "type": "object",
        "required": ["name"],
        "x-schema-org": "schema:DefinedTerm",
        "x-openregister": { "publicRead": false, "publicWrite": false },
        "properties": {
          "name":        { "type": "string", "example": "Dogs" },
          "description": { "type": "string", "example": "Friendly mammals, four legs, often barks" }
        }
      },
      "pet": {
        "slug": "pet",
        "icon": "Paw",
        "version": "0.3.0",
        "title": "Pet",
        "description": "A pet in the store.",
        "type": "object",
        "required": ["name", "category", "status"],
        "x-schema-org": "schema:Product",
        "x-openregister": { "publicRead": false, "publicWrite": false },
        "properties": {
          "name":   { "type": "string", "example": "doggie" },
          "category": {
            "type": "string",
            "format": "uuid",
            "$ref": "category",
            "description": "Reference to the pet's category (uuid of the category object)."
          },
          "status": { "type": "string", "enum": ["available", "pending", "sold"] },
          "tags":   { "type": "array", "items": { "type": "string" } },
          "photoUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "price":  { "type": "number",  "minimum": 0, "example": 49.95 },
          "notes":  { "type": "string" },
          "owner":  {
            "type": "string",
            "format": "uuid",
            "title": "Owner",
            "description": "Portal-subject/owner reference — the UUID of the owner contact (a domain object reference, never a Nextcloud user id). Portaliq scopes external portal reads to this field (hydra ADR-046 A4)."
          }
        }
      },
      "order": {
        "slug": "order",
        "icon": "Receipt",
        "version": "0.3.0",
        "title": "Order",
        "description": "A customer order for a pet.",
        "type": "object",
        "required": ["pet", "quantity", "status"],
        "x-schema-org": "schema:Order",
        "x-openregister": { "publicRead": false, "publicWrite": false },
        "properties": {
          "pet": {
            "type": "string",
            "format": "uuid",
            "$ref": "pet",
            "description": "Reference to the ordered pet (uuid of the pet object)."
          },
          "quantity": { "type": "integer", "minimum": 1, "example": 1 },
          "shipDate": { "type": "string", "format": "date-time" },
          "status":   { "type": "string", "enum": ["placed", "approved", "delivered"] },
          "complete": { "type": "boolean", "default": false },
          "owner":    {
            "type": "string",
            "format": "uuid",
            "title": "Owner",
            "description": "Portal-subject/owner reference — the UUID of the owner contact (a domain object reference, never a Nextcloud user id). Portaliq scopes external portal reads and creates to this field (hydra ADR-046 A4)."
          }
        }
      }
    }
  }
}

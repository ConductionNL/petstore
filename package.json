{
  "name": "petstore",
  "version": "0.1.7",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "stylelint": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\"",
    "stylelint-fix": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\" --fix",
    "check:manifest": "node tests/validate-manifest.js",
    "check:manifest-v2": "node tests/manifest-v2.spec.js",
    "check:register": "node tests/validate-register.js",
    "check:registry": "node tests/registry.spec.js",
    "check:json-strict": "node tests/validate-json-strict.js",
    "check:specs": "npm run check:json-strict && npm run check:manifest-v2 && npm run check:register && npm run check:registry"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@conduction/nextcloud-vue": "^2.9.1",
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.0.0",
    "@vueuse/core": "^14.0.0",
    "babel-loader": "^10.1.1",
    "dompurify": "^3.0.0",
    "gridstack": "^12.0.0",
    "marked": "^12.0.0",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.5.0"
  },
  "overrides": {
    "libxmljs2": "^0.37.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/vue": "^9.0.0",
    "eslint-import-resolver-typescript": "~3.8.7",
    "eslint-plugin-import-x": {
      "@typescript-eslint/utils": "^7.18.0"
    }
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.0",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.10.0",
    "css-loader": "~7.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^24.1.3",
    "path-browserify": "^1.0.1",
    "postcss-html": "^1.8.1",
    "sass": "^1.99.0",
    "sass-loader": "^17.0.0",
    "style-loader": "~4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "terser-webpack-plugin": "^5.3.11",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.3.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  }
}

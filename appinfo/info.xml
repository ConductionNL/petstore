<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>petstore</id>
    <name lang="en">{APP_NAME}</name>
    <name lang="nl">{APP_NAME}</name>
    <summary lang="en">{APP_SUMMARY}</summary>
    <summary lang="nl">{APP_SUMMARY}</summary>
    <description lang="en"><![CDATA[{APP_DESCRIPTION}]]></description>
    <description lang="nl"><![CDATA[{APP_DESCRIPTION}]]></description>
    <version>0.1.6</version>
    <licence>eupl</licence>
    <author mail="info@conduction.nl" homepage="https://www.conduction.nl/">Conduction</author>
    <namespace>PetStore</namespace>
    <documentation>
        <user>https://codeberg.org/Conduction/nextcloud-petstore</user>
        <admin>https://codeberg.org/Conduction/nextcloud-petstore</admin>
        <developer>https://codeberg.org/Conduction/nextcloud-petstore</developer>
    </documentation>
    <category>tools</category>
    <website>https://codeberg.org/Conduction/nextcloud-petstore</website>
    <discussion>https://codeberg.org/Conduction/nextcloud-petstore/discussions</discussion>
    <bugs>https://codeberg.org/Conduction/nextcloud-petstore/issues</bugs>
    <repository>https://codeberg.org/Conduction/nextcloud-petstore</repository>

    <screenshot>https://codeberg.org/Conduction/nextcloud-petstore/raw/branch/main/img/app-store.svg</screenshot>

    <dependencies>
        <nextcloud min-version="28" max-version="34"/>
        <php min-version="8.3"/>
    </dependencies>

    <navigations>
        <navigation>
            <id>petstore</id>
            <name>PetStore</name>
            <route>petstore.dashboard.page</route>
            <icon>app.svg</icon>
        </navigation>
    </navigations>

    <!-- @spec openspec/architecture/adr-023-action-authorization.md -->
    <repair-steps>
        <install>
            <step>OCA\PetStore\Repair\InitializeSettings</step>
            <step>OCA\PetStore\Repair\InitializeActions</step>
        </install>
        <post-migration>
            <step>OCA\PetStore\Repair\InitializeSettings</step>
            <step>OCA\PetStore\Repair\InitializeActions</step>
        </post-migration>
    </repair-steps>

    <settings>
        <admin>OCA\PetStore\Settings\AdminSettings</admin>
        <admin-section>OCA\PetStore\Sections\SettingsSection</admin-section>
    </settings>
</info>

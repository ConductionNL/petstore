{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.2.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Examples",
			"label": "Examples",
			"icon": "icon-files",
			"route": "Examples",
			"order": 20
		},
		{
			"id": "Categories",
			"label": "Categories",
			"icon": "icon-category-organization",
			"route": "Categories",
			"order": 30
		},
		{
			"id": "Orders",
			"label": "Orders",
			"icon": "icon-category-workflow",
			"route": "Orders",
			"order": 40
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://petstore.conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 100
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"widgets": [
				{
					"widgetKey": "page-header",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 1,
					"props": {
						"title": "Dashboard",
						"description": "Daily overview of pets, orders and categories",
						"icon": "Paw"
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 0,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Available pets",
						"iconClass": "icon-files",
						"register": "petstore",
						"schema": "pet",
						"filters": { "status": "available" },
						"countLabel": "pets",
						"variant": "success",
						"route": { "name": "Examples", "query": { "status": "available" } }
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 3,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Pending reservations",
						"iconClass": "icon-history",
						"register": "petstore",
						"schema": "pet",
						"filters": { "status": "pending" },
						"countLabel": "pets",
						"variant": "warning",
						"route": { "name": "Examples", "query": { "status": "pending" } }
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 6,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Open orders",
						"iconClass": "icon-category-workflow",
						"register": "petstore",
						"schema": "order",
						"filters": { "complete": "false" },
						"countLabel": "orders",
						"variant": "primary",
						"route": { "name": "Orders", "query": { "complete": "false" } }
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 9,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Categories",
						"iconClass": "icon-category-organization",
						"register": "petstore",
						"schema": "category",
						"countLabel": "categories",
						"variant": "default",
						"route": { "name": "Categories" }
					}
				},
				{
					"widgetKey": "chart-by-field",
					"slot": "body",
					"gridX": 0,
					"gridY": 2,
					"gridWidth": 6,
					"gridHeight": 3,
					"props": {
						"title": "Pets per category",
						"register": "petstore",
						"schema": "pet",
						"field": "category",
						"chartType": "donut"
					}
				},
				{
					"widgetKey": "chart-by-field",
					"slot": "body",
					"gridX": 6,
					"gridY": 2,
					"gridWidth": 6,
					"gridHeight": 3,
					"props": {
						"title": "Orders by status",
						"register": "petstore",
						"schema": "order",
						"field": "status",
						"chartType": "bar"
					}
				},
				{
					"widgetKey": "recent-objects",
					"slot": "body",
					"gridX": 0,
					"gridY": 5,
					"gridWidth": 12,
					"gridHeight": 3,
					"props": {
						"title": "Recent orders",
						"register": "petstore",
						"schema": "order",
						"columns": ["pet", "quantity", "shipDate", "status", "complete"],
						"limit": 5
					}
				}
			]
		},
		{
			"id": "Examples",
			"route": "/examples",
			"type": "index",
			"title": "Pets",
			"config": {
				"register": "petstore",
				"schema": "pet",
				"columns": [
					"name",
					"category",
					"status",
					"price"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ExampleDetail",
			"route": "/examples/:id",
			"type": "detail",
			"title": "Pet",
			"config": {
				"register": "petstore",
				"schema": "pet",
				"documentationUrl": "https://petstore.conduction.nl",
				"_note": "Product/catalog archetype for a single pet (ADR-062 rev3). The pet schema is small (name, category, status, tags, photoUrls, price, notes — 7 fields): one 2-column data widget covers it cleanly, so it is deliberately NOT split into 'Core'/'Process' groups the way procest's case is — splitting a 7-field schema would just scatter it across two thin cards with nothing distinct to separate (judgment call, ADR-062 rule 3 'don't split for splitting's sake'). The former summaryAggregates chip ('Orders for this pet') is now an in-grid stats-block, top-right of the data widget per rule 2, with the Related panel (category + orders) stacked below it in the same column — a real, useful KPI (how many orders reference this pet), not manufactured. The pet's photos and documents get a full-width Files leaf below — photoUrls is a URI array, so imagery is a primary content type here. The schema declares NO email/calendar/talk linkedType, so this record carries NO comms leaves (no vet-appointment calendar). The audit trail is a rarely-read history, so it stays a sidebar tab.",
				"widgets": [
					{ "id": "pet-data", "type": "data", "title": "Pet details", "icon": "Package", "content": { "columns": 2 } },
					{ "id": "pet-stats", "type": "stats-block", "title": "Orders", "icon": "Cash", "content": { "entries": [ { "title": "Orders for this pet", "register": "petstore", "schema": "order", "metric": "count", "filter": { "pet": "@objectId" } } ] } },
					{ "id": "pet-related", "type": "related", "title": "Category & orders", "icon": "LinkVariant" },
					{ "id": "pet-files", "type": "integration", "integrationId": "files", "title": "Photos & documents", "icon": "FolderOutline" }
				],
				"layout": [
					{ "id": "1", "widgetId": "pet-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "2", "widgetId": "pet-stats", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "3", "widgetId": "pet-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 3 },
					{ "id": "4", "widgetId": "pet-files", "gridX": 0, "gridY": 5, "gridWidth": 12, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Categories",
			"route": "/categories",
			"type": "index",
			"title": "Categories",
			"config": {
				"register": "petstore",
				"schema": "category",
				"columns": [
					"name",
					"description"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "CategoryDetail",
			"route": "/categories/:id",
			"type": "detail",
			"title": "Category",
			"config": {
				"register": "petstore",
				"schema": "category",
				"documentationUrl": "https://petstore.conduction.nl",
				"_note": "Catalog archetype for a pet category (Dogs, Cats, ...) — ADR-062 rev3. A category is a thin grouping (only name + description), so its purpose on the detail page is still to answer 'which pets are in it?': the dominant 8-wide column is a live object-list of the pets whose 'category' FK points at this record (viewAllRoute → Examples, filtered by category), and the narrow 4-wide column stacks the compact data card ABOVE the former summaryAggregates chips (now an in-grid stats-block with the same two KPIs: pet count + available count) — an intentional inversion of the CaseDetail 8/4 data-left pattern, kept from round 1, because here the LIST is the primary content, not the data card (rule 2's canonical layout describes a reference shape, not a mandate; content drives placement). No comms leaves (the schema declares none), no Files (categories carry no attachments). Audit history stays a sidebar tab.",
				"widgets": [
					{ "id": "category-data", "type": "data", "title": "Category", "icon": "TagOutline", "content": { "columns": 1 } },
					{ "id": "category-stats", "type": "stats-block", "title": "Pets", "icon": "Package", "content": { "entries": [ { "title": "Pets in category", "register": "petstore", "schema": "pet", "metric": "count", "filter": { "category": "@objectId" } }, { "title": "Available", "register": "petstore", "schema": "pet", "metric": "count", "filter": { "category": "@objectId", "status": "available" } } ] } },
					{ "id": "category-pets", "type": "object-list", "title": "Pets in this category", "icon": "TableColumn", "content": { "register": "petstore", "schema": "pet", "filter": { "category": "@objectId" }, "sort": { "field": "name", "dir": "asc" }, "columns": [{ "key": "name", "label": "Name" }, { "key": "status", "label": "Status" }, { "key": "price", "label": "Price" }], "limit": 25, "rowRoute": "ExampleDetail", "viewAllRoute": "Examples", "viewAllQuery": { "category": "@objectId" }, "emptyText": "No pets in this category yet.", "allowCreate": true } }
				],
				"layout": [
					{ "id": "1", "widgetId": "category-data", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 3 },
					{ "id": "2", "widgetId": "category-stats", "gridX": 0, "gridY": 3, "gridWidth": 4, "gridHeight": 3 },
					{ "id": "3", "widgetId": "category-pets", "gridX": 4, "gridY": 0, "gridWidth": 8, "gridHeight": 6 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Orders",
			"route": "/orders",
			"type": "index",
			"title": "Orders",
			"config": {
				"register": "petstore",
				"schema": "order",
				"showTitle": true,
				"selectable": false,
				"inlineSearch": true,
				"searchPlaceholder": "Search by name",
				"filterMenu": true,
				"columnMenu": true,
				"cardsLabel": "Tiles",
				"tableLabel": "List",
				"cardsIcon": "TilesGrid",
				"tableIcon": "ListRows",
				"icon": "Receipt",
				"rowIcon": "FileDocumentOutline",
				"columns": [
					"pet",
					"quantity",
					{
						"key": "status",
						"label": "status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"placed": "primary",
								"approved": "warning",
								"delivered": "success"
							}
						}
					},
					"complete"
				],
				"sidebar": {
					"enabled": false
				}
			}
		},
		{
			"id": "OrderDetail",
			"route": "/orders/:id",
			"type": "detail",
			"title": "Order",
			"config": {
				"register": "petstore",
				"schema": "order",
				"documentationUrl": "https://petstore.conduction.nl",
				"_note": "Transaction archetype for a customer order — ADR-062 rev3. What matters when opening an order is 'what was ordered, in what state, and where are the papers': the body leads with the transaction fields (pet, quantity, status, shipDate, complete) in an 8-wide data card and a Related panel (4-wide) linking the ordered pet, with a full-width Files leaf below for the invoice / shipping documents. DELIBERATE EXCEPTION to rule 2's KPI placement: round 1's summaryAggregates ('Items ordered', sum of quantity filtered to this order's own id) was dropped rather than converted to a stats-block — it was a thin, self-referential aggregate that only restated the order's own 'quantity' field (already visible in the data card) via a filter matching the object's own id; an order is atomic (no child line-items, no collection to summarize), so there is no real KPI to show here. Manufacturing an empty-content 4-wide card would be worse than no KPI at all. The order schema is atomic so there is NO object-list of sub-lines. The schema declares no email/calendar/talk linkedType, so this record carries NO comms leaves and NO meetings. Audit history stays a sidebar tab.",
				"widgets": [
					{ "id": "order-data", "type": "data", "title": "Order details", "icon": "Cash", "content": { "columns": 2 } },
					{ "id": "order-related", "type": "related", "title": "Ordered pet", "icon": "LinkVariant" },
					{ "id": "order-files", "type": "integration", "integrationId": "files", "title": "Invoice & documents", "icon": "FolderOutline" }
				],
				"layout": [
					{ "id": "1", "widgetId": "order-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "2", "widgetId": "order-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 4 },
					{ "id": "3", "widgetId": "order-files", "gridX": 0, "gridY": 4, "gridWidth": 12, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/petstore/api/settings",
				"sections": [
					{
						"title": "Version",
						"widgets": [
							{
								"type": "version-info",
								"props": {
									"appName": "PetStore",
									"showUpdateButton": false,
									"isUpToDate": true,
									"title": "Version Information",
									"description": "Information about the current installation."
								}
							}
						]
					}
				]
			},
			"widgets": [
				{
					"widgetKey": "version-info",
					"slot": "section:version",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 1,
					"props": {
						"appName": "PetStore",
						"showUpdateButton": false,
						"isUpToDate": true,
						"title": "Version Information",
						"description": "Information about the current installation."
					}
				}
			]
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://petstore.conduction.nl"
			}
		}
	]
}

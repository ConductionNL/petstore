{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.2.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Examples",
			"label": "Examples",
			"icon": "icon-files",
			"route": "Examples",
			"order": 20
		},
		{
			"id": "Categories",
			"label": "Categories",
			"icon": "icon-category-organization",
			"route": "Categories",
			"order": 30
		},
		{
			"id": "Orders",
			"label": "Orders",
			"icon": "icon-category-workflow",
			"route": "Orders",
			"order": 40
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://codeberg.org/Conduction/petstore",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 100
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"widgets": [
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Available pets",
						"iconClass": "icon-files",
						"register": "petstore",
						"schema": "pet",
						"countLabel": "pets",
						"variant": "primary"
					}
				}
			]
		},
		{
			"id": "Examples",
			"route": "/examples",
			"type": "index",
			"title": "Pets",
			"config": {
				"register": "petstore",
				"schema": "pet",
				"columns": [
					"name",
					"category",
					"status",
					"price"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ExampleDetail",
			"route": "/examples/:id",
			"type": "detail",
			"title": "Pet",
			"config": {
				"register": "petstore",
				"schema": "pet",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "object-data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Categories",
			"route": "/categories",
			"type": "index",
			"title": "Categories",
			"config": {
				"register": "petstore",
				"schema": "category",
				"columns": [
					"name",
					"description"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "CategoryDetail",
			"route": "/categories/:id",
			"type": "detail",
			"title": "Category",
			"config": {
				"register": "petstore",
				"schema": "category",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "object-data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Orders",
			"route": "/orders",
			"type": "index",
			"title": "Orders",
			"config": {
				"register": "petstore",
				"schema": "order",
				"columns": [
					"pet",
					"quantity",
					"status",
					"complete"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "OrderDetail",
			"route": "/orders/:id",
			"type": "detail",
			"title": "Order",
			"config": {
				"register": "petstore",
				"schema": "order",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "object-data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/petstore/api/settings",
				"sections": [
					{
						"title": "Version",
						"widgets": [
							{
								"type": "version-info",
								"props": {
									"appName": "PetStore",
									"showUpdateButton": false,
									"isUpToDate": true,
									"title": "Version Information",
									"description": "Information about the current installation."
								}
							}
						]
					}
				]
			},
			"widgets": [
				{
					"widgetKey": "version-info",
					"slot": "section:version",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 1,
					"props": {
						"appName": "PetStore",
						"showUpdateButton": false,
						"isUpToDate": true,
						"title": "Version Information",
						"description": "Information about the current installation."
					}
				}
			]
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://petstore.conduction.nl"
			}
		}
	]
}

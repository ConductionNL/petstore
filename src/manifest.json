{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.2.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Examples",
			"label": "Examples",
			"icon": "icon-files",
			"route": "Examples",
			"order": 20
		},
		{
			"id": "Categories",
			"label": "Categories",
			"icon": "icon-category-organization",
			"route": "Categories",
			"order": 30
		},
		{
			"id": "Orders",
			"label": "Orders",
			"icon": "icon-category-workflow",
			"route": "Orders",
			"order": 40
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://petstore.conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 100
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"widgets": [
				{
					"widgetKey": "page-header",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 1,
					"props": {
						"title": "Dashboard",
						"description": "Daily overview of pets, orders and categories",
						"icon": "Paw"
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 0,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Available pets",
						"iconClass": "icon-files",
						"register": "petstore",
						"schema": "pet",
						"filters": { "status": "available" },
						"countLabel": "pets",
						"variant": "success"
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 3,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Pending reservations",
						"iconClass": "icon-history",
						"register": "petstore",
						"schema": "pet",
						"filters": { "status": "pending" },
						"countLabel": "pets",
						"variant": "warning"
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 6,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Open orders",
						"iconClass": "icon-category-workflow",
						"register": "petstore",
						"schema": "order",
						"filters": { "complete": "false" },
						"countLabel": "orders",
						"variant": "primary"
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 9,
					"gridY": 1,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Categories",
						"iconClass": "icon-category-organization",
						"register": "petstore",
						"schema": "category",
						"countLabel": "categories",
						"variant": "default"
					}
				},
				{
					"widgetKey": "chart-by-field",
					"slot": "body",
					"gridX": 0,
					"gridY": 2,
					"gridWidth": 6,
					"gridHeight": 3,
					"props": {
						"title": "Pets per category",
						"register": "petstore",
						"schema": "pet",
						"field": "category",
						"chartType": "donut"
					}
				},
				{
					"widgetKey": "chart-by-field",
					"slot": "body",
					"gridX": 6,
					"gridY": 2,
					"gridWidth": 6,
					"gridHeight": 3,
					"props": {
						"title": "Orders by status",
						"register": "petstore",
						"schema": "order",
						"field": "status",
						"chartType": "bar"
					}
				},
				{
					"widgetKey": "recent-objects",
					"slot": "body",
					"gridX": 0,
					"gridY": 5,
					"gridWidth": 12,
					"gridHeight": 3,
					"props": {
						"title": "Recent orders",
						"register": "petstore",
						"schema": "order",
						"columns": ["pet", "quantity", "shipDate", "status", "complete"],
						"limit": 5
					}
				}
			]
		},
		{
			"id": "Examples",
			"route": "/examples",
			"type": "index",
			"title": "Pets",
			"config": {
				"register": "petstore",
				"schema": "pet",
				"columns": [
					"name",
					"category",
					"status",
					"price"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ExampleDetail",
			"route": "/examples/:id",
			"type": "detail",
			"title": "Pet",
			"config": {
				"register": "petstore",
				"schema": "pet",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "object-data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Categories",
			"route": "/categories",
			"type": "index",
			"title": "Categories",
			"config": {
				"register": "petstore",
				"schema": "category",
				"columns": [
					"name",
					"description"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "CategoryDetail",
			"route": "/categories/:id",
			"type": "detail",
			"title": "Category",
			"config": {
				"register": "petstore",
				"schema": "category",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "object-data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Orders",
			"route": "/orders",
			"type": "index",
			"title": "Orders",
			"config": {
				"register": "petstore",
				"schema": "order",
				"showTitle": true,
				"selectable": false,
				"inlineSearch": true,
				"searchPlaceholder": "Search by name",
				"filterMenu": true,
				"cardsLabel": "Tiles",
				"tableLabel": "List",
				"icon": "Receipt",
				"rowIcon": "FileDocumentOutline",
				"columns": [
					"pet",
					"quantity",
					{
						"key": "status",
						"label": "status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"placed": "primary",
								"approved": "warning",
								"delivered": "success"
							}
						}
					},
					"complete"
				],
				"sidebar": {
					"enabled": false
				}
			}
		},
		{
			"id": "OrderDetail",
			"route": "/orders/:id",
			"type": "detail",
			"title": "Order",
			"config": {
				"register": "petstore",
				"schema": "order",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "object-data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/petstore/api/settings",
				"sections": [
					{
						"title": "Version",
						"widgets": [
							{
								"type": "version-info",
								"props": {
									"appName": "PetStore",
									"showUpdateButton": false,
									"isUpToDate": true,
									"title": "Version Information",
									"description": "Information about the current installation."
								}
							}
						]
					}
				]
			},
			"widgets": [
				{
					"widgetKey": "version-info",
					"slot": "section:version",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 1,
					"props": {
						"appName": "PetStore",
						"showUpdateButton": false,
						"isUpToDate": true,
						"title": "Version Information",
						"description": "Information about the current installation."
					}
				}
			]
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://petstore.conduction.nl"
			}
		}
	]
}
